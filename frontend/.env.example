# Copy to .env. Only EXPO_PUBLIC_ variables reach the app, and they are visible in the
# bundle - never put a secret here. The JWT secret and Google client secret stay on the server.

# Android emulator reaches the host machine on 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# Physical device on the same Wi-Fi: use your computer's LAN IP instead.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api

# Google OAuth client IDs (public identifiers, not secrets).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
