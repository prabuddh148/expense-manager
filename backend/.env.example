# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- Database (dev profile, local PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_manager
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# --- Database (prod profile) ---
# Full JDBC URL, e.g. jdbc:postgresql://host/db?sslmode=require
# DB_URL=

# --- JWT ---
# Generate one, e.g.  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google Sign-In (optional until you create OAuth clients) ---
# Comma-separated list of accepted OAuth client IDs (Android, iOS, Web).
GOOGLE_CLIENT_IDS=

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- Redis response cache (optional, off by default) ---
# REDIS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CACHE_TTL=PT10M

# --- Kafka activity events (optional, off by default) ---
# KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
